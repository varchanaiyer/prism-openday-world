# Log level (0 = none, 1 = info, 2 = verbose)
LOG_LEVEL=1
# Tileset optimization
TILESET_OPTIMIZATION=false
TILESET_OPTIMIZATION_QUALITY_MIN=0.9
TILESET_OPTIMIZATION_QUALITY_MAX=1.0
# Deploy strategy: the GitHub Actions workflow pushes dist/ to the gh-pages branch
UPLOAD_MODE=GH_PAGES
# Where the pages are served from (must be https). Used by scripts/world.cjs
PAGES_BASE=https://varchanaiyer.github.io/prism-openday-world
